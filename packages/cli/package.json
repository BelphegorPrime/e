{
  "name": "@monorepo/cli",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "e": "./dist/index.js"
  },
  "scripts": {
    "start": "npm run build:ts && node dist/index.js",
    "test": "npm run build:ts && node dist/test-build.js",
    "build:ts": "tsc",
    "build:bin": "pkg ./dist/index.js -t node24-linux-x64,node24-macos-x64,node24-win-x64,node24-linux-arm64,node24-macos-arm64,node24-win-arm64 --output ./command/e --fallback-to-source",
    "build": "npm run build:ts && npm run build:bin"
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/commander": "^2.12.0",
    "@types/node": "^26.1.2",
    "@yao-pkg/pkg": "^6.22.0",
    "typescript": "^7.0.2"
  }
}
