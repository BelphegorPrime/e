{
  "name": "@monorepo/cli",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "e": "./dist/index.js"
  },
  "scripts": {
    "start": "npm run build:ts && node dist/index.js --help",
    "test": "npm run build:ts && node dist/test-build.js",
    "build:ts": "tsc",
    "build:js": "webpack --config webpack.config.js",
    "build:bin": "pkg ./dist/bundle.js -t latest-linux-x64,latest-macos-x64,latest-win-x64,latest-linux-arm64,latest-win-arm64 --output ./command/e",
    "build": "npm run build:ts && npm run build:js && npm run build:bin"
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/commander": "^2.12.0",
    "@types/node": "^26.1.2",
    "pkg": "^5.8.1",
    "ts-loader": "^9.6.2",
    "typescript": "^7.0.2",
    "webpack": "^5.109.2",
    "webpack-cli": "^5.1.4"
  }
}
