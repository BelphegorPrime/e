{
  "name": "@e/cli",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "e": "./dist/index.js"
  },
  "scripts": {
    "start": "npm run build:ts && node dist/index.js",
    "test": "npm run build:ts && node --test \"dist/**/*.test.js\"",
    "build:ui": "cd ui && webpack --config webpack.config.js --mode production",
    "dev:ui": "cd ui && webpack serve --config webpack.config.js --mode development",
    "build:ts": "tsc",
    "prebuild:bin": "node scripts/ensure-ui-assets.mjs",
    "build:bin": "pkg -c ./package.json ./dist/index.js -t node24-linux-x64,node24-macos-x64,node24-win-x64,node24-linux-arm64,node24-macos-arm64,node24-win-arm64 --output ./command/e --fallback-to-source",
    "build:dev": "npm run build:ui && npm run build:ts",
    "build": "npm run build:dev && npm run build:bin",
    "link": "npm run build:dev && npm link",
    "test:ui-assets": "node --test \"scripts/*.test.mjs\""
  },
  "pkg": {
    "assets": [
      "dist/ui/**/*"
    ]
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "autoprefixer": "^10.5.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "commander": "^15.0.0",
    "express": "^4.22.2",
    "lucide-react": "^1.41.0",
    "mustache": "^4.2.0",
    "postcss": "^8.5.28",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@types/commander": "^2.12.0",
    "@types/express": "^4.17.25",
    "@types/mustache": "^4.2.6",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@yao-pkg/pkg": "^6.22.0",
    "css-loader": "^7.1.5",
    "html-webpack-plugin": "^5.6.8",
    "postcss-loader": "^8.2.1",
    "style-loader": "^4.0.0",
    "tailwindcss-animate": "^1.0.7",
    "ts-loader": "^9.6.2",
    "typescript": "^7.0.2",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.0",
    "webpack-dev-server": "^4.15.0"
  }
}
