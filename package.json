{
  "name": "@e/cli",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "e": "./dist/index.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "npm run build:ts && node dist/index.js",
    "test": "npm run build:ts && node --test \"dist/**/*.test.js\"",
    "test:coverage": "npm run build:ts && node --test --experimental-test-coverage \"dist/**/*.test.js\"",
    "build:ui": "cd ui && webpack --config webpack.config.mjs --mode production",
    "dev:ui": "cd ui && webpack serve --config webpack.config.mjs --mode development",
    "build:ts": "npm run build:egress-api && npm run build:broker && tsc",
    "prebuild:bin": "node scripts/ensure-ui-assets.mjs",
    "prebuild:version": "node scripts/generate-version.mjs",
    "build:bin": "npm run prebuild:version && npm run build:ts && pkg . --sea --output ./command/e --fallback-to-source && node scripts/restore-version.mjs",
    "build:dev": "npm run build:ui && npm run build:ts",
    "build": "npm run build:dev && npm run build:bin",
    "link": "npm run build:dev && npm link",
    "test:ui-assets": "node --test \"scripts/**/*.test.mjs\"",
    "smoke:ui": "node scripts/smoke-ui/smoke-ui.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:egress-api": "node scripts/build-egress-api.mjs",
    "build:broker": "node scripts/build-broker.mjs"
  },
  "pkg": {
    "assets": [
      "dist/ui/**/*"
    ],
    "targets": [
      "node24-linux-x64",
      "node24-linux-arm64",
      "node24-macos-x64",
      "node24-macos-arm64",
      "node24-win-x64",
      "node24-win-arm64"
    ],
    "outputPath": "command",
    "signature": true
  },
  "dependencies": {
    "@bomb.sh/tab": "^0.0.22",
    "@earendil-works/pi-tui": "^0.85.1",
    "adm-zip": "^0.6.0",
    "archiver": "^8.0.0",
    "commander": "^15.0.0",
    "express": "^5.2.1",
    "http-proxy-middleware": "^4.2.0",
    "mustache": "^4.2.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@a2a-js/sdk": "^1.1.0",
    "@eslint/js": "^10.0.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/archiver": "^8.0.0",
    "@types/express": "^5.0.6",
    "@types/mustache": "^4.2.6",
    "@types/node": "^26.1.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@yao-pkg/pkg": "^6.22.0",
    "ajv": "^8.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "css-loader": "^7.1.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "globals": "^17.12.0",
    "html-webpack-plugin": "^5.6.8",
    "lucide-react": "^1.41.0",
    "pixelmatch": "^7.2.0",
    "playwright-core": "^1.63.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.28",
    "postcss-loader": "^8.2.1",
    "prettier": "^3.9.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.3",
    "style-loader": "^4.0.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "ts-loader": "^9.6.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "webpack": "^5.88.0",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
